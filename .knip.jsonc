// vim:set expandtab shiftwidth=4 filetype=jsonc:
// SPDX-License-Identifier: GPL-3.0-only

//
//
// ~chewygumxx/agent-library.git
// ::: :/.knip.jsonc
//
//

// https://knip.dev/reference/configuration
//
// knip finds the entry files by itself; this file lists only what it cannot
// see. Each pattern is a regular expression.
{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    // `bun test` finds these by name, which knip does not follow.
    "entry": ["tests/*.test.mts"],
    "ignoreDependencies": [
        // The shared configurations, named by path in the package scripts,
        // by `extends` or `import`, or from `.secretlintrc.json`.
        "@chewygumxx/.+",
        // Run by the package scripts through `xargs`, which knip does not
        // follow.
        "cspell",
        "secretlint",
        // Extended by @chewygumxx/commitlint-config, which depends on them.
        "@commitlint/config-conventional",
        "conventional-changelog-conventionalcommits",
        // Read for its skills by `skills experimental_sync`, not imported.
        "superpowers"
    ],
    // Pinned in `mise.toml` rather than installed as packages.
    "ignoreBinaries": ["actionlint", "editorconfig-checker"]
}
